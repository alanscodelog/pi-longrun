{
	"name": "pi-longrun",
	"version": "0.1.0",
	"description": "Background jobs and scheduled wakeups for the pi coding agent",
	"type": "module",
	"license": "MIT",
	"author": "Takuma Mori",
	"homepage": "https://github.com/takuma104/pi-longrun#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/takuma104/pi-longrun.git"
	},
	"bugs": {
		"url": "https://github.com/takuma104/pi-longrun/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"src",
		"docs",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest --run",
		"dev": "pi -e ./src/index.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.74.2",
		"@earendil-works/pi-tui": "^0.74.2",
		"@types/node": "^24.3.0",
		"typebox": "^1.3.28",
		"typescript": "^5.7.3",
		"vitest": "^3.2.4"
	},
	"keywords": [
		"pi-package",
		"pi",
		"coding-agent",
		"background-jobs",
		"long-running"
	]
}
